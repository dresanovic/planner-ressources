# Pin this to the exact release you intend to deploy.
PLANNER_IMAGE=ghcr.io/dresanovic/planner-ressources:v1.0.0

# Host port used to open the application.
PLANNER_PORT=8080

INSTITUTION_TIMEZONE=Europe/Vienna

# Required: generate at least 32 random bytes and keep this value stable.
# Linux/macOS: openssl rand -hex 32
# PowerShell:
# $key = New-Object byte[] 32; $rng = [Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($key); $rng.Dispose(); [BitConverter]::ToString($key).Replace('-', '').ToLowerInvariant()
LECTURER_REVIEW_SOURCE_FINGERPRINT_KEY=
